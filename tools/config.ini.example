# 可选配置：装了多个 FGO、或想换区服时，在这里指定包名
#
# 用法：把本文件复制一份，改名为 config.ini（config.ini 不存在时，脚本会自动探测）
#
# 常见包名：
#   package=com.bilibili.fgo.qihoo        # 国服 360 渠道服（默认）
#   package=com.bilibili.fatego           # 国服 B 服
#   package=com.aniplex.fategrandorder    # 日服 / 台服
#
# 不确定自己的包名？在模拟器已开的时候执行：
#   adb shell pm list packages | findstr -i fate
#
package=

# ---- 自动点击（可选，A / B 两个入口共用）----
# 开启后，脚本启动 FGO 会自动连点「屏幕正中央」，点过「请点击游戏界面」/【登录】。
#   A（抓包）：抓到 toplogin 立即停；超时没抓到则结束脚本（不再干等）。
#   B（不抓包）：没有抓包信号，连点到公告/通知页后按 plain_tap_duration 自动停。
#
# 实测耗时参考：脚本启动→FGO 首次联网约 13s，联网→toplogin 落地约 27s，
# 单次完整约 40s，故 A 默认 90s 留足余量、B 默认 40s 覆盖到公告页。
#
# auto_tap=1              # 1=开启（默认），0=关闭（自己手点）
# tap_interval=1.5        # 点击间隔（秒）
# tap_timeout=90          # A：持续多久没抓到就结束（秒）
# plain_tap_duration=40   # B：连点到公告/通知页的时长（秒）
#
# 点击坐标（可选）：不填则自动按分辨率算「屏幕正中央」（改分辨率无需改这里）
# 只有在中央点不中按钮时才需要填（例如换了非 16:9 分辨率导致 UI 布局变化）
#   tap_x=640
#   tap_y=360

# ---- 状态弹窗（可选）----
# 抓包过程常驻的进度小弹窗（准备中→正在启动 FGO→等待登录…）
# 关掉后所有进度/提示只在 cmd 窗口显示，屏幕更干净
#
# status_popup=1       # 1=显示进度弹窗（默认），0=关闭（只看 cmd 窗口）
